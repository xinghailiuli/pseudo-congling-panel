{
  "name": "dsh-whale-status",
  "version": "1.2.0",
  "private": true,
  "description": "琉璃陪伴中心：原生 DSH 记忆、长夜、梦境、日记与 QQ 管理。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "assets"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "layout"
      ]
    }
  },
  "displayName": "伪从绫开始的面板 1.2 · 太空视窗与全家具交互重构版"
}
