{
  "name": "dsh-whale-status",
  "version": "1.3.2",
  "private": true,
  "description": "星海回响 HUD、双层小屋、大肥鱼之岛 3D 沉浸探索、星海探索舱、南码头重塑星海小船环岛巡游、离岸蓝鲸生态、地面漫步、2K 明信片工坊与 Web Audio 声景。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "assets"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "layout"
      ]
    }
  },
  "displayName": "星海回响 1.3.2 - 大肥鱼之岛小船重塑、探索舱与流畅度优化版"
}
